{
  "name": "meituan-helper",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --mac --win",
    "postinstall": "patch-package",
    "dev": "nodemon --watch main.js --watch db.js --exec electron .",
    "build:reports": "node scripts/build-reports.cjs",
    "prestart": "node scripts/build-reports.cjs",
    "prebuild": "node scripts/build-reports.cjs",
    "prebuild:mac": "node scripts/build-reports.cjs",
    "prebuild:win": "node scripts/build-reports.cjs",
    "prebuild:all": "node scripts/build-reports.cjs",
    "predev": "node scripts/build-reports.cjs"
  },
  "author": "chenchuan",
  "license": "ISC",
  "description": "美团助手",
  "build": {
    "appId": "com.meituan.helper",
    "productName": "美团助手",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "simple-board.js",
      "task-error-notice.js",
      "db.js",
      "reply-template-rotation.js",
      "auto-helper.js",
      "iframe-bridge.js",
      "index.html",
      "settings.html",
      "dashboard.html",
      "docs/**/*",
      "analysis.html",
      "analysis-core.js",
      "analysis-service.js",
      "analysis-main.js",
      "report-assets/**/*",
      "comparison-core.js",
      "analysis-pdf.js",
      "report-print.html"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^3.2.9",
    "esbuild": "^0.28.2",
    "nodemon": "^3.1.14",
    "patch-package": "^8.0.1"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "antd": "^6.7.0",
    "better-sqlite3": "^12.11.1",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "playwright": "^1.59.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
